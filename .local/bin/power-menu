#!/bin/bash

choice=$(printf "performance\nbalanced\npower-saver" | anyrun --plugins libstdin.so --show-results-immediately true)

case "$choice" in
    performance)
        powerprofilesctl set performance
        ;;
    balanced)
        powerprofilesctl set balanced
        ;;
    power-saver)
        powerprofilesctl set power-saver
        ;;
esac

